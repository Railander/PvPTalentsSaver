package-as: PvPTalentsSaver
enable-nolib-creation: no
manual-changelog: CHANGELOG.md

# EXCLUSIONARY MINDSET (house rule -- see ../AGENTS.md): only .lua + .toc +
# CHANGELOG.md + LICENSE may ship (this repo has no logo file). The packager
# archives tracked files at the tag, so every other tracked file must be
# listed below.
ignore:
    - README.md
    - .gitignore
    - .gitattributes
    - .github
    - tests
    # backup: gitignored and untracked, never packaged either way
    - AGENTS.md
    - AGENTS_MEMORY.md
